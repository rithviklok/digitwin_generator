# Copy this file to .env and fill it in. No cloud service, database, or paid
# account is required to run this backend -- everything lives on this machine.

# Port the backend listens on.
PORT=8787
# Interface to listen on. Blank = all interfaces (open http://<this-PC's-IP>:8787
# from the LAN). Behind nginx/Apache on the same machine, set 127.0.0.1 so the
# proxy is the only way in.
HOST=

# Where uploaded files, bake output, and the SQLite database are stored.
# Relative paths resolve against this server/ folder. Must be on a disk with
# room for baked cities -- a single city's tiles can run into the gigabytes
# (see README.md, Part 2, "The scripts/ folder", and NEW_CITY_CHECKLIST.md).
STORAGE_ROOT=./storage

# Shared secret for the admin page (open <site>/?admin=<this value>): lists
# every uploaded city, opens any of them, shows build logs, deletes a city.
# Required -- see config.js for what happens if this is left blank.
ADMIN_TOKEN=

# The largest buildings file accepted, in megabytes. 4096 (4 GB) is about
# twice the largest Indian metro's: Delhi with Gurgaon, Noida, Ghaziabad and
# Faridabad is about 2.1 GB (54 lakh buildings in Google Open Buildings);
# Kanpur is 283 MB. Every other file is limited to 500 MB whatever this says.
# A reverse proxy in front must allow at least as much (HOSTING.md).
MAX_UPLOAD_MB=4096

# How long one upload may take to arrive, in minutes. 2 GB in 2 hours needs
# only 2.4 Mbit/s; raise this for slower connections.
UPLOAD_TIMEOUT_MIN=120

# How long a single building-tile bake is allowed to run before it's killed
# and the job marked failed, in minutes. The uploader's Review & build page
# shows an estimated time left, and warns if the build is on course to pass
# this limit.
BAKE_TIMEOUT_MIN=120

# Shared OpenWeatherMap key used for EVERY city this instance hosts, the
# built-in Kanpur included (OWM bills by request, keyed by lat/lon -- one key
# covers any number of cities). It is added to a city when the city is opened,
# so setting or changing it needs only a restart of this server, no rebuild.
# Leave blank to run without live weather (the scene keeps its day look and a
# Day / Night button); get a free key at openweathermap.org.
WEATHER_API_KEY=

# Prefix for the tile/layer URLs stored in each built city. Leave blank:
# relative /files/... URLs then work at any address (LAN IP, domain, inside
# an iframe). Only set it when /files is served from another host, e.g. a
# CDN. Never http://localhost:... -- that gets stored in every city built
# with it and those links then only work on this machine.
PUBLIC_API_BASE_URL=

# -- Hosting (see HOSTING.md) ---------------------------------------------

# This process serves the built front end (../dist, from `npm run build` at
# the project root), so page + API + tiles share one address. Leave unset
# for that default; set a path to serve another build; set it empty
# (FRONTEND_DIR=) when your reverse proxy serves dist/ itself.
# FRONTEND_DIR=../dist

# Behind nginx/Apache, set this so uploader quotas see each visitor's real IP
# instead of the proxy's. "loopback" when the proxy runs on this machine;
# otherwise the proxy's IP address. Leave blank for direct connections.
TRUST_PROXY=

# Sites allowed to show the viewer in an iframe (?embed=1) -- and therefore
# to control it through its API and receive what users click (see HOSTING.md,
# "Decision for IT"). Blank = any site. Comma-separated origins to restrict, e.g.
# https://airawat.example.in,https://partner.example.com
EMBED_ALLOWED_ORIGINS=

# -- Housekeeping and limits ----------------------------------------------

# A city whose build failed, and that has no live version, has its files
# (raw upload + bake output) automatically deleted this many days after
# that build -- the DB row stays, marked 'purged', so the history isn't
# lost, just the disk-heavy bytes. Runs in-process every 12 hours.
RETENTION_DAYS=7

# Per-uploader quota (keyed by the uploading browser's IP address -- uploads
# don't ask for an email): how many of one uploader's cities may be building
# or waiting to build at once.
MAX_CONCURRENT_UPLOADS_PER_UPLOADER=2

# Roads, railway, amenities, land use, vegetation, water and locality names
# are downloaded from OpenStreetMap for the drawn area during every build.
# Public Overpass servers are often busy, so several are tried in order.
# Leave blank for the built-in list; set a comma-separated list to override
# (e.g. your own Overpass instance).
OVERPASS_ENDPOINTS=
# Outbound HTTP proxy (institute networks). The OpenStreetMap download runs in
# a child process that reads these at startup; Node ignores HTTPS_PROXY unless
# NODE_USE_ENV_PROXY=1 is also set. Leave all three blank for direct access.
NODE_USE_ENV_PROXY=
HTTPS_PROXY=
NO_PROXY=
# How long the OpenStreetMap download may take for an ordinary city, which
# is asked for in one part. A large area is asked for in several parts and
# gets 2 minutes more for each further part (a Delhi-sized area: 17
# requests, 48 minutes; it took 7 when tested). When the time runs out the
# build carries on with the layers that arrived, and the uploader's Review
# & build page says which are missing. Parts that were downloaded are kept
# for a week, so revising the city asks only for the rest.
OSM_FETCH_TIMEOUT_MIN=20

# How long downloading a city's buildings from Google Open Buildings may
# take, when the uploader chose "Get them for me from Google Open
# Buildings" (the upload form's default). Kanpur: about 0.7 GB, 6 minutes on
# a fast line. When the time runs out the build stops and says so.
# Needs outbound HTTPS to storage.googleapis.com (the proxy above applies).
BUILDINGS_FETCH_TIMEOUT_MIN=90

# Refuse an upload/bake rather than risk running the host out of disk
# mid-write. A bake needs roughly 7x its raw input size on disk (Kanpur's
# own measured ratio); this is the minimum free space, in GB, that must
# remain AFTER that projected usage.
MIN_FREE_SPACE_GB=5

# CORS. Leave blank (the default) for wide-open access -- fine for local
# use and novice self-hosting, since the real access boundary is the
# per-route tokens (ADMIN_TOKEN / a city's own access token), not the
# browser's origin. Set a comma-separated list of exact origins (e.g.
# https://mytwin.example.com,https://admin.example.com) to switch to a
# strict allowlist instead.
ALLOWED_ORIGINS=
