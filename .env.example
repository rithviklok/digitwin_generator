# Copy this file to .env (Vite loads it automatically; restart `npm run dev`
# after creating/editing it). Only variables prefixed VITE_ are exposed to
# front-end code, via import.meta.env.

# Where the front end calls the self-hosted backend (server/). Leave it unset:
# the page then calls /api and /files on its own origin -- the backend serves
# the built page in production, and `npm run dev` / `npm run preview` proxy
# to it (vite.config.js; DIGITWIN_BACKEND changes the proxy target, default
# http://localhost:8787). Only set this if the backend lives on a different
# origin than the page, and then list that origin in server ALLOWED_ORIGINS.
# VITE_API_BASE_URL=https://twin-api.example.in
