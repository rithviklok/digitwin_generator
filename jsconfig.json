{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable", "webworker.importscripts"],
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "scripts/**/*.mjs", "server/**/*.js", "vite.config.js"],
  "exclude": ["node_modules", "server/node_modules", "dist", "public", "server/storage"]
}
