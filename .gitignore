node_modules/
dist/
*.log
.env

# Baked building tiles: ~1.9 GB, regenerated by
# `node scripts/build-building-tiles.mjs --city kanpur`. manifest.json stays tracked.
public/data/*/tiles/**/*.bin

# Raw Kanpur buildings source (283 MB, over GitHub's 100 MB file limit).
# Needed to re-bake the tiles; untracked, so back it up separately.
public/data/kanpur/Kanpur_OpenBuildings_2_5D.geojson

# What scripts/fetch-open-buildings.mjs writes when run from the project
# folder (hundreds of MB), and its unfinished file if a run is stopped.
/*_OpenBuildings_2_5D.geojson
/*_MicrosoftBuildings.geojson
*.geojson.part
